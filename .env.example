POSTGRES_USER=preston_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=preston_ai_chatbot

# Application settings (optional; defaults shown).
# PRESTON_APP_NAME=Preston AI Chatbot
# PRESTON_ENVIRONMENT=local
# PRESTON_LOG_LEVEL=INFO
# PRESTON_API_V1_PREFIX=/api/v1

# Database (optional for this phase; no default, and nothing connects yet).
# PRESTON_DATABASE_URL=postgresql+psycopg://preston_app:CHANGE_ME@localhost:5432/preston_ai_chatbot

# Dedicated database for the test suite. DB-backed tests resolve this variable
# and only this one -- never PRESTON_DATABASE_URL -- so they cannot read or
# write the ingestion corpus; unset it and they skip. It must name a different
# database from PRESTON_DATABASE_URL, which the fixtures enforce. Create it once
# on the same server and migrate it:
#   createdb preston_ai_chatbot_test
#   PRESTON_DATABASE_URL="$PRESTON_TEST_DATABASE_URL" uv run alembic upgrade head
# PRESTON_TEST_DATABASE_URL=postgresql+psycopg://preston_app:CHANGE_ME@localhost:5432/preston_ai_chatbot_test

# MySQL source system (decision record B2; optional, read-only, source extraction not wired yet).
# PRESTON_SOURCE_MYSQL_URL=mysql+pymysql://CHANGE_ME:CHANGE_ME@localhost:3306/website_db
